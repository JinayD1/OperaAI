# Copy this file to backend/.env and fill in the values.
# backend/.env is gitignored - never commit real credentials.

# ---------------------------------------------------------------------------
# Models - every call routes through OpenRouter (OpenAI-compatible API)
# ---------------------------------------------------------------------------
# Copy this from backendv2/.env, or get a new one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional overrides. Defaults are set in app/config.py.
# MODEL_DIAGNOSE=google/gemini-2.5-pro
# MODEL_DEFAULT=google/gemini-2.5-flash
# MODEL_CHEAP=google/gemini-2.5-flash-lite

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string -> URI,
# then replace [YOUR-PASSWORD] with the password you set at project creation.
# Looks like:
#   postgresql://postgres.abcdefgh:PASSWORD@aws-0-ca-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ---------------------------------------------------------------------------
# Object storage (AWS S3)
# ---------------------------------------------------------------------------
# From the IAM user you created (opera-ai-backend). The bucket must stay
# private - the app hands out short-lived presigned URLs instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ca-central-1
S3_BUCKET=

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Invent any long random string. The Next.js proxy sends it as a bearer token
# so the pipeline isn't open to anyone who knows a case id.
# Generate one with:  openssl rand -hex 32
API_BEARER_TOKEN=

PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
