# Copy to .env and fill in real values. See README.md for details.

# All AI model calls route through OpenRouter (OpenAI-compatible API).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: override the model. Defaults to google/gemini-2.5-flash.
# OPENROUTER_MODEL=google/gemini-2.5-flash

# Cloudinary (image hosting + annotation overlays)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Postgres (cases/assets/jobs tables) — required for the /api/cases/* API
DATABASE_URL=

# Supabase Storage (signed upload URLs for raw case assets)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional quota / retention knobs (defaults applied in code)
# MAX_ASSETS_PER_CASE=
# MAX_TOTAL_BYTES_PER_CASE=
# MAX_PENDING_PER_USER=
# RETENTION_DAYS=
# ORPHAN_CASE_HOURS=
